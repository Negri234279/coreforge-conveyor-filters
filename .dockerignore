# VCS / editor
.git
.gitignore
.gitattributes
.github
.vscode
.idea

# Build output / caches
dist
.astro
node_modules
*.log
npm-debug.log*

# Env / secrets
.env
.env.*

# Raw image sources — inputs to `npm run optimize:{boxes,images}` only. The
# build serves the optimized WebP under public/{boxes,items}; Astro would copy
# these verbatim into dist/client and ship them, so keep them out of the image.
public/boxes-raw
public/items-raw

# Local dev data (kept out of image; runtime uses the DATA_DIR volume)
src/data/filters.dev.json
src/data/filters.prod.json
src/data/*.db
src/data/*.db-wal
src/data/*.db-shm

# Docker / docs (not needed at build time)
Dockerfile
.dockerignore
docker-compose*.yml
README.md
CLAUDE.md

# OS junk
.DS_Store
Thumbs.db
