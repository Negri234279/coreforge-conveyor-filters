# DEVELOPMENT observability stack env. Copy to .env if you want to override
# the defaults. .env is gitignored. The dev compose has safe inline fallbacks,
# so a missing .env is fine — only set this if you need to deviate.

# Optional: Discord webhook for Alertmanager. Usually left empty in dev —
# alerts are still visible at http://127.0.0.1:9090/alerts and in Grafana.
COREFORGE_DISCORD_WEBHOOK_URL=

# Optional: host interface Grafana (13000) and Prometheus (19090) bind to.
# Default 127.0.0.1 (loopback-only). Set to this machine's LAN IP if a
# dockerized client (e.g. the mcp/grafana MCP server) must reach them —
# containers can't dial the host's loopback.
# OBS_BIND_HOST=192.168.1.11
