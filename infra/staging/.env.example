# STAGING stack env (app + observability, single compose).
# Copy to `.env` (gitignored) and fill in the required values below.
# Loaded both for compose interpolation AND as the app's env_file.

# ── Grafana ─────────────────────────────────────────────────────────────

# Required: staging Grafana may be LAN/NPM-exposed, so auth stays on.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Bind address for Grafana on host port 13001. Loopback by default; flip to
# 0.0.0.0 if NPM at 192.168.1.7 proxies grafana.staging.<domain> to
# 192.168.1.11:13001.
STAGING_GRAFANA_BIND=127.0.0.1

# ── Alerting ────────────────────────────────────────────────────────────

# Optional: Discord webhook for the staging Alertmanager. Use a DIFFERENT
# channel/webhook than prod so test alerts never page the real channel.
COREFORGE_DISCORD_WEBHOOK_URL=

# ── App ─────────────────────────────────────────────────────────────────

# Bind address for the app's published port 8081. Defaults to 0.0.0.0 so
# NPM can reach it via the host IP. Use 127.0.0.1 to keep it local.
STAGING_BIND=0.0.0.0

# Bind address for Alloy's OTLP HTTP receiver on host port 4320 and the Faro
# RUM collector on host port 12347. Defaults to 0.0.0.0 because NPM has to
# reach them from another machine (the RPi).
STAGING_OTLP_HTTP_BIND=0.0.0.0

# Browser RUM (Grafana Faro) collector URL. Leave commented to use the
# default (otlp.staging.* /collect via NPM); set empty to disable RUM in
# staging (backend OTel still works). Requires an NPM custom location
# /collect → 192.168.1.11:12347 on the otlp.staging.* proxy host.
# FARO_COLLECTOR_URL=https://otlp.staging.coreforge-conveyor-filters.negri.es/collect

# Admin "Grafana" button URL. Defaults to http://127.0.0.1:13001.
# GRAFANA_URL=https://grafana.staging.coreforge-conveyor-filters.negri.es
